// Session A
show_sesa = input.bool(true, '', inline = 'sesa', group = 'Session A')
sesa_txt = input.string('New York', '', inline = 'sesa', group = 'Session A')
sesa_ses = input.session('1330-2200', '', inline = 'sesa', group = 'Session A')
sesa_css = input.color(#ff5d00, '', inline = 'sesa', group = 'Session A')

sesa_range = input.bool(true, 'Spanne', inline = 'sesa_overlays', group = 'Session A')
sesa_tl = input.bool(false, 'Trendline', inline = 'sesa_overlays', group = 'Session A')
sesa_avg = input.bool(false, 'Mean', inline = 'sesa_overlays', group = 'Session A')
sesa_vwap = input.bool(false, 'VWAP', inline = 'sesa_overlays', group = 'Session A')
sesa_maxmin = input.bool(false, 'Max/Min', inline = 'sesa_overlays', group = 'Session A')

// Session B
show_sesb = input.bool(true, '', inline = 'sesb', group = 'Session B')
sesb_txt = input.string('London', '', inline = 'sesb', group = 'Session B')
sesb_ses = input.session('0600-1800', '', inline = 'sesb', group = 'Session B')
sesb_css = input.color(#2157f3, '', inline = 'sesb', group = 'Session B')

sesb_range = input.bool(true, 'Spanne', inline = 'sesb_overlays', group = 'Session B')
sesb_tl = input.bool(false, 'Trendline', inline = 'sesb_overlays', group = 'Session B')
sesb_avg = input.bool(false, 'Mean', inline = 'sesb_overlays', group = 'Session B')
sesb_vwap = input.bool(false, 'VWAP', inline = 'sesb_overlays', group = 'Session B')
sesb_maxmin = input.bool(false, 'Max/Min', inline = 'sesb_overlays', group = 'Session B')

// Session C
show_sesc = input.bool(true, '', inline = 'sesc', group = 'Session C')
sesc_txt = input.string('Tokyo', '', inline = 'sesc', group = 'Session C')
sesc_ses = input.session('0000-0900', '', inline = 'sesc', group = 'Session C')
sesc_css = input.color(#e91e63, '', inline = 'sesc', group = 'Session C')

sesc_range = input.bool(true, 'Spanne', inline = 'sesc_overlays', group = 'Session C')
sesc_tl = input.bool(false, 'Trendline', inline = 'sesc_overlays', group = 'Session C')
sesc_avg = input.bool(false, 'Mean', inline = 'sesc_overlays', group = 'Session C')
sesc_vwap = input.bool(false, 'VWAP', inline = 'sesc_overlays', group = 'Session C')
sesc_maxmin = input.bool(false, 'Max/Min', inline = 'sesc_overlays', group = 'Session C')

// Session D
show_sesd = input.bool(false, '', inline = 'sesd', group = 'Session D')
sesd_txt = input.string('Sydney', '', inline = 'sesd', group = 'Session D')
sesd_ses = input.session('2100-0600', '', inline = 'sesd', group = 'Session D')
sesd_css = input.color(#ffeb3b, '', inline = 'sesd', group = 'Session D')

sesd_range = input.bool(true, 'Spanne', inline = 'sesd_overlays', group = 'Session D')
sesd_tl = input.bool(false, 'Trendline', inline = 'sesd_overlays', group = 'Session D')
sesd_avg = input.bool(false, 'Mean', inline = 'sesd_overlays', group = 'Session D')
sesd_vwap = input.bool(false, 'VWAP', inline = 'sesd_overlays', group = 'Session D')
sesd_maxmin = input.bool(false, 'Max/Min', inline = 'sesd_overlays', group = 'Session D')

// Timezones
tz_incr = input.int(0, 'UTC (+/-)', group = 'Timezone')
use_exchange = input.bool(false, 'Use Exchange Timezone', group = 'Timezone')

// Ranges Options
bg_transp = input.float(90, 'Range Area Transparency', group = 'Ranges Settings')
show_outline = input.bool(true, 'Range Outline', group = 'Ranges Settings')
show_txt = input.bool(true, 'Range Label', group = 'Ranges Settings')

// Dashboard
show_dash = input.bool(false, 'Show Dashboard', group = 'Dashboard')
advanced_dash = input.bool(false, 'Advanced Dashboard', group = 'Dashboard')
dash_loc = input.string('Top Right', 'Dashboard Location', options = ['Top Right', 'Bottom Right', 'Bottom Left'], group = 'Dashboard')
sessions_text_size = input.string('Small', 'Dashboard Size', options = ['Tiny', 'Small', 'Normal'], group = 'Dashboard')

// Divider
show_ses_div = input.bool(false, 'Show Sessions Divider', group = 'Dividers')
show_day_div = input.bool(false, 'Show Daily Divider', group = 'Dividers')

get_avg(session) =>
    var int sess_len = 1
    var float csma = na
    var float sma = na
    if session and not session[1]
        sess_len := 1
        csma := close
    if session and session[1]
        sess_len += 1
        csma += close
        sma := csma / sess_len
    sma

get_linreg(session) =>
    var int sess_len = 1
    var float cwma = na
    var float csma = na
    var float csma2 = na
    var float y1 = na
    var float y2 = na
    var float stdev = na
    var float r2 = na
    if session and not session[1]
        sess_len := 1
        cwma := close
        csma := close
        csma2 := close * close
    if session and session[1]
        sess_len += 1
        csma += close
        csma2 += close * close
        cwma += close * sess_len
        sma = csma / sess_len
        wma = cwma / (sess_len * (sess_len + 1) / 2)
        cov = (wma - sma) * (sess_len + 1) / 2
        stdev := math.sqrt(csma2 / sess_len - sma * sma)
        r2 := cov / (stdev * (math.sqrt(sess_len * sess_len - 1) / (2 * math.sqrt(3))))
        y1 := 4 * sma - 3 * wma
        y2 := 3 * wma - 2 * sma
    [y1, y2, stdev, r2]

get_vwap(session) =>
    var float num = na
    var float den = na
    if session and not session[1]
        num := close * volume
        den := volume
    else if session and session[1]
        num += close * volume
        den += volume
    else
        num := na
    [num, den]

set_session_line(session, y1, y2, session_css) =>
    var line tl = na
    if session and not session[1]
        tl := line.new(n, close, n, close, color = session_css)
    if session and session[1]
        line.set_y1(tl, y1)
        line.set_xy2(tl, n, y2)

get_range(session, session_name, session_css) =>
    var int session_start_time = 0
    var float session_max = high
    var float session_min = low
    var box bx = na
    var label lbl = na
    if session and not session[1]
        session_start_time := time
        session_max := high
        session_min := low
        bx := box.new(n, session_max, n, session_min, bgcolor = color.new(session_css, bg_transp), border_color = show_outline ? session_css : na, border_style = line.style_dotted)
        if show_txt
            lbl := label.new(session_start_time, session_max, session_name, xloc = xloc.bar_time, textcolor = session_css, style = label.style_label_down, color = color.new(color.white, 100), size = size.tiny)
    if session and session[1]
        session_max := math.max(high, session_max)
        session_min := math.min(low, session_min)
        box.set_top(bx, session_max)
        box.set_rightbottom(bx, n, session_min)
        if show_txt
            label.set_xy(lbl, int(math.avg(session_start_time, time)), session_max)
    [session ? na : session_max, session ? na : session_min]

sessions_tf = timeframe.period
var sessions_tz = use_exchange ? syminfo.timezone : str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

is_sesa = not na(time(sessions_tf, sesa_ses, sessions_tz))
is_sesb = not na(time(sessions_tf, sesb_ses, sessions_tz))
is_sesc = not na(time(sessions_tf, sesc_ses, sessions_tz))
is_sesd = not na(time(sessions_tf, sesd_ses, sessions_tz))

var table_position = dash_loc == 'Bottom Left' ? position.bottom_left : dash_loc == 'Top Right' ? position.top_right : position.bottom_right
var table_size = sessions_text_size == 'Tiny' ? size.tiny : sessions_text_size == 'Small' ? size.small : size.normal
var tb = table.new(table_position, 5, 6, bgcolor = #1e222d, border_color = #373a46, border_width = 1, frame_color = #373a46, frame_width = 1)

if barstate.isfirst and show_dash
    table.cell(tb, 0, 0, 'LuxAlgo', text_color = color.white, text_size = table_size)
    table.merge_cells(tb, 0, 0, 4, 0)
    table.cell(tb, 0, 2, sesa_txt, text_color = sesa_css, text_size = table_size)
    table.cell(tb, 0, 3, sesb_txt, text_color = sesb_css, text_size = table_size)
    table.cell(tb, 0, 4, sesc_txt, text_color = sesc_css, text_size = table_size)
    table.cell(tb, 0, 5, sesd_txt, text_color = sesd_css, text_size = table_size)
    if advanced_dash
        table.cell(tb, 0, 1, 'Session', text_color = color.white, text_size = table_size)
        table.cell(tb, 1, 1, 'Status', text_color = color.white, text_size = table_size)
        table.cell(tb, 2, 1, 'Trend', text_color = color.white, text_size = table_size)
        table.cell(tb, 3, 1, 'Volume', text_color = color.white, text_size = table_size)
        table.cell(tb, 4, 1, 'σ', text_color = color.white, text_size = table_size)

if barstate.islast and show_dash
    table.cell(tb, 1, 2, is_sesa ? 'Active' : 'Innactive', bgcolor = is_sesa ? #089981 : #f23645, text_color = color.white, text_size = table_size)
    table.cell(tb, 1, 3, is_sesb ? 'Active' : 'Innactive', bgcolor = is_sesb ? #089981 : #f23645, text_color = color.white, text_size = table_size)
    table.cell(tb, 1, 4, is_sesc ? 'Active' : 'Innactive', bgcolor = is_sesc ? #089981 : #f23645, text_color = color.white, text_size = table_size)
    table.cell(tb, 1, 5, is_sesd ? 'Active' : 'Innactive', bgcolor = is_sesd ? #089981 : #f23645, text_color = color.white, text_size = table_size)

var float max_sesa = na
var float min_sesa = na
var float max_sesb = na
var float min_sesb = na
var float max_sesc = na
var float min_sesc = na
var float max_sesd = na
var float min_sesd = na

if show_sesa and sesa_range
    [max, min] = get_range(is_sesa, sesa_txt, sesa_css)
    max_sesa := max
    min_sesa := min
if show_sesb and sesb_range
    [max, min] = get_range(is_sesb, sesb_txt, sesb_css)
    max_sesb := max
    min_sesb := min
if show_sesc and sesc_range
    [max, min] = get_range(is_sesc, sesc_txt, sesc_css)
    max_sesc := max
    min_sesc := min
if show_sesd and sesd_range
    [max, min] = get_range(is_sesd, sesd_txt, sesd_css)
    max_sesd := max
    min_sesd := min

if show_sesa and (sesa_tl or advanced_dash)
    [y1, y2, stdev, r2] = get_linreg(is_sesa)
    if advanced_dash
        table.cell(tb, 2, 2, str.tostring(r2, '#.##'), bgcolor = r2 > 0 ? #089981 : #f23645, text_color = color.white, text_size = table_size)
        table.cell(tb, 4, 2, str.tostring(stdev, '#.####'), text_color = color.white, text_size = table_size)
    if sesa_tl
        set_session_line(is_sesa, y1, y2, sesa_css)
if show_sesb and (sesb_tl or advanced_dash)
    [y1, y2, stdev, r2] = get_linreg(is_sesb)
    if advanced_dash
        table.cell(tb, 2, 3, str.tostring(r2, '#.##'), bgcolor = r2 > 0 ? #089981 : #f23645, text_color = color.white, text_size = table_size)
        table.cell(tb, 4, 3, str.tostring(stdev, '#.####'), text_color = color.white, text_size = table_size)
    if sesb_tl
        set_session_line(is_sesb, y1, y2, sesb_css)
if show_sesc and (sesc_tl or advanced_dash)
    [y1, y2, stdev, r2] = get_linreg(is_sesc)
    if advanced_dash
        table.cell(tb, 2, 4, str.tostring(r2, '#.##'), bgcolor = r2 > 0 ? #089981 : #f23645, text_color = color.white, text_size = table_size)
        table.cell(tb, 4, 4, str.tostring(stdev, '#.####'), text_color = color.white, text_size = table_size)
    if sesc_tl
        set_session_line(is_sesc, y1, y2, sesc_css)
if show_sesd and (sesd_tl or advanced_dash)
    [y1, y2, stdev, r2] = get_linreg(is_sesd)
    if advanced_dash
        table.cell(tb, 2, 5, str.tostring(r2, '#.##'), bgcolor = r2 > 0 ? #089981 : #f23645, text_color = color.white, text_size = table_size)
        table.cell(tb, 4, 5, str.tostring(stdev, '#.####'), text_color = color.white, text_size = table_size)
    if sesd_tl
        set_session_line(is_sesd, y1, y2, sesd_css)

if show_sesa and sesa_avg
    avg = get_avg(is_sesa)
    set_session_line(is_sesa, avg, avg, sesa_css)
if show_sesb and sesb_avg
    avg = get_avg(is_sesb)
    set_session_line(is_sesb, avg, avg, sesb_css)
if show_sesc and sesc_avg
    avg = get_avg(is_sesc)
    set_session_line(is_sesc, avg, avg, sesc_css)
if show_sesd and sesd_avg
    avg = get_avg(is_sesd)
    set_session_line(is_sesd, avg, avg, sesd_css)

var float vwap_a = na
var float vwap_b = na
var float vwap_c = na
var float vwap_d = na

if show_sesa and (sesa_vwap or advanced_dash)
    [num, den] = get_vwap(is_sesa)
    if sesa_vwap
        vwap_a := num / den
    if advanced_dash
        table.cell(tb, 3, 2, str.tostring(den, format.volume), text_color = color.white, text_size = table_size)
if show_sesb and (sesb_vwap or advanced_dash)
    [num, den] = get_vwap(is_sesb)
    if sesb_vwap
        vwap_b := num / den
    if advanced_dash
        table.cell(tb, 3, 3, str.tostring(den, format.volume), text_color = color.white, text_size = table_size)
if show_sesc and (sesc_vwap or advanced_dash)
    [num, den] = get_vwap(is_sesc)
    if sesc_vwap
        vwap_c := num / den
    if advanced_dash
        table.cell(tb, 3, 4, str.tostring(den, format.volume), text_color = color.white, text_size = table_size)
if show_sesd and (sesd_vwap or advanced_dash)
    [num, den] = get_vwap(is_sesd)
    if sesd_vwap
        vwap_d := num / den
    if advanced_dash
        table.cell(tb, 3, 5, str.tostring(den, format.volume), text_color = color.white, text_size = table_size)

plot(sesa_maxmin ? max_sesa : na, 'Session A Maximum', sesa_css, 1, plot.style_linebr)
plot(sesa_maxmin ? min_sesa : na, 'Session A Minimum', sesa_css, 1, plot.style_linebr)
plot(sesb_maxmin ? max_sesb : na, 'Session B Maximum', sesb_css, 1, plot.style_linebr)
plot(sesb_maxmin ? min_sesb : na, 'Session B Minimum', sesb_css, 1, plot.style_linebr)
plot(sesc_maxmin ? max_sesc : na, 'Session C Maximum', sesc_css, 1, plot.style_linebr)
plot(sesc_maxmin ? min_sesc : na, 'Session C Minimum', sesc_css, 1, plot.style_linebr)
plot(sesd_maxmin ? max_sesd : na, 'Session D Maximum', sesd_css, 1, plot.style_linebr)
plot(sesd_maxmin ? min_sesd : na, 'Session D Minimum', sesd_css, 1, plot.style_linebr)
plot(vwap_a, 'Session A VWAP', sesa_css, 1, plot.style_linebr)
plot(vwap_b, 'Session B VWAP', sesb_css, 1, plot.style_linebr)
plot(vwap_c, 'Session C VWAP', sesc_css, 1, plot.style_linebr)
plot(vwap_d, 'Session D VWAP', sesd_css, 1, plot.style_linebr)

plotshape(is_sesa and show_ses_div and show_sesa, '·', shape.square, location.bottom, na, text = '.', textcolor = sesa_css, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(is_sesa != is_sesa[1] and show_ses_div and show_sesa, 'NYE', shape.labelup, location.bottom, na, text = '❚', textcolor = sesa_css, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(is_sesb and show_ses_div and show_sesb, '·', shape.labelup, location.bottom, na, text = '.', textcolor = sesb_css, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(is_sesb != is_sesb[1] and show_ses_div and show_sesb, 'LDN', shape.labelup, location.bottom, na, text = '❚', textcolor = sesb_css, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(is_sesc and show_ses_div and show_sesc, '·', shape.square, location.bottom, na, text = '.', textcolor = sesc_css, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(is_sesc != is_sesc[1] and show_ses_div and show_sesc, 'TYO', shape.labelup, location.bottom, na, text = '❚', textcolor = sesc_css, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(is_sesd and show_ses_div and show_sesd, '·', shape.labelup, location.bottom, na, text = '.', textcolor = sesd_css, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(is_sesd != is_sesd[1] and show_ses_div and show_sesd, 'SYD', shape.labelup, location.bottom, na, text = '❚', textcolor = sesd_css, size = size.tiny, display = display.all - display.status_line, editable = false)

sessions_day = dayofweek
if sessions_day != sessions_day[1] and show_day_div
    line.new(n, close + syminfo.mintick, n, close - syminfo.mintick, color = color.gray, extend = extend.both, style = line.style_dashed)
    sessions_day_txt = sessions_day == 1 ? 'Sunday' : sessions_day == 2 ? 'Monday' : sessions_day == 3 ? 'Tuesday' : sessions_day == 4 ? 'Wednesday' : sessions_day == 5 ? 'Thursday' : sessions_day == 6 ? 'Friday' : 'Saturday'
    label.new(n, high, sessions_day_txt, style = label.style_label_down, textcolor = color.gray, color = color.new(color.white, 100), size = size.tiny)




//------------------------------------------------------------------------------
// Fractals (Nephew_Sam_) Integration
//------------------------------------------------------------------------------
var string fractals_grp = "••••••• FRACTALS •••••••"
showFractals = input.bool(true, title = 'Show fractal points?', group = fractals_grp)
filterFractal = input.string(title = 'Filter 3/5 bar fractal', defval = '3', options = ['3', '5'], group = fractals_grp)

isRegularFractal(mode, fractal_n) =>
    ret = mode == 'Buy' ? high[fractal_n - 1] < high[fractal_n] and high[fractal_n + 1] < high[fractal_n] : mode == 'Sell' ? low[fractal_n - 1] > low[fractal_n] and low[fractal_n + 1] > low[fractal_n] : false
    ret

isBWFractal(mode, fractal_n) =>
    ret = mode == 'Buy' ? high[fractal_n - 2] < high[fractal_n] and high[fractal_n - 1] < high[fractal_n] and high[fractal_n + 1] < high[fractal_n] and high[fractal_n + 2] < high[fractal_n] : mode == 'Sell' ? low[fractal_n - 2] > low[fractal_n] and low[fractal_n - 1] > low[fractal_n] and low[fractal_n + 1] > low[fractal_n] and low[fractal_n + 2] > low[fractal_n] : false
    ret

isFractalHigh(i) =>
    filterFractal == '3' ? isRegularFractal('Buy', i) : isBWFractal('Buy', i + 1)

isFractalLow(i) =>
    filterFractal == '3' ? isRegularFractal('Sell', i) : isBWFractal('Sell', i + 1)

plotshape(showFractals and isFractalHigh(1), title = 'Fractal High', style = shape.triangledown, location = location.abovebar, color = color.black, offset = filterFractal == '3' ? -1 : -2, size = size.auto)
plotshape(showFractals and isFractalLow(1), title = 'Fractal Low', style = shape.triangleup, location = location.belowbar, color = color.black, offset = filterFractal == '3' ? -1 : -2, size = size.auto)

// Pivots
var string pivots_grp = "••••••• PIVOTS •••••••"
ShowPivots = input.bool(title = 'Show Pivot points?', defval = false, group = pivots_grp)
fractal_lb = input.int(5, title = 'Left Bars', minval = 1, inline = '1', group = pivots_grp)
fractal_rb = input.int(4, title = 'Right Bars', minval = 1, inline = '1', group = pivots_grp)
showHHLL = input.bool(true, title = 'Show HH/LL?', group = pivots_grp)
hhCol = input.color(color.lime, 'HH', inline = '2', group = pivots_grp)
lhCol = input.color(color.red, 'LH', inline = '2', group = pivots_grp)
llCol = input.color(color.red, 'LL', inline = '2', group = pivots_grp)
hlCol = input.color(color.lime, 'HL', inline = '2', group = pivots_grp)

var pivotHighs = array.new_float(3)
var pivotLows = array.new_float(3)

fractal_ph = ta.pivothigh(fractal_lb, fractal_rb)
fractal_ph1 = ta.valuewhen(not na(fractal_ph), high[fractal_rb], 1)
fractal_phSince = ta.barssince(not na(fractal_ph))

fractal_pl = ta.pivotlow(fractal_lb, fractal_rb)
fractal_pl1 = ta.valuewhen(not na(fractal_pl), low[fractal_rb], 1)

hh = fractal_ph > fractal_ph1
lh = fractal_ph < fractal_ph1
ll = fractal_pl < fractal_pl1
hl = fractal_pl > fractal_pl1

_transparent = color.new(color.white, 100)

plotshape(not na(fractal_ph) and ShowPivots and hh, title = 'HH', style = shape.triangledown, location = location.abovebar, text = 'HH', textcolor = showHHLL ? hhCol : _transparent, color = hhCol, offset = -fractal_rb, size = size.auto)
plotshape(not na(fractal_ph) and ShowPivots and lh, title = 'LH', style = shape.triangledown, location = location.abovebar, text = 'LH', textcolor = showHHLL ? lhCol : _transparent, color = lhCol, offset = -fractal_rb, size = size.auto)

plotshape(not na(fractal_pl) and ShowPivots and ll, title = 'LL', style = shape.triangleup, location = location.belowbar, text = 'LL', textcolor = showHHLL ? llCol : _transparent, color = llCol, offset = -fractal_rb, size = size.auto)
plotshape(not na(fractal_pl) and ShowPivots and hl, title = 'HL', style = shape.triangleup, location = location.belowbar, text = 'HL', textcolor = showHHLL ? hlCol : _transparent, color = hlCol, offset = -fractal_rb, size = size.auto)

var lastPH = 'na'
var lastPL = 'na'

if not na(fractal_ph)
    if hh
        lastPH := 'HH'
    else if lh
        lastPH := 'LH'




